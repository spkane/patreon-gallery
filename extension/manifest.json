{
  "manifest_version": 3,
  "name": "Gallery Scout for Patreon",
  "version": "0.3.4",
  "description": "Browse posts already available in your signed-in Patreon tab. No cookies leave Chrome.",
  "icons": {
    "128": "assets/patreon-gallery-icon.png"
  },
  "action": {
    "default_title": "Open Gallery Scout"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://player.vimeo.com"
  },
  "permissions": ["scripting", "downloads", "downloads.open"],
  "host_permissions": [
    "https://www.patreon.com/*"
  ],
  "content_scripts": [{
    "matches": ["https://www.patreon.com/*"],
    "js": ["feed.js", "content.js"],
    "run_at": "document_idle"
  }]
}
