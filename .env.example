# Copy these into your shell before running server.py.
# You create these in Patreon's developer portal for an OAuth client.
PATREON_CLIENT_ID=replace-me
PATREON_CLIENT_SECRET=replace-me
PATREON_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# Optional. Generate with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PATREON_GALLERY_SESSION_SECRET=replace-with-random-secret

# Optional.
PORT=8000

# Default scopes request identity and memberships. If your Patreon app is approved
# for broader creator/campaign scopes, you can append them here.
PATREON_SCOPES=identity identity[email] identity.memberships

# Optional: creator-token mode. These are useful for campaigns you own/manage.
# They generally do NOT unlock posts for arbitrary subscriber memberships.
PATREON_GALLERY_CREATOR_ACCESS_TOKEN=
PATREON_GALLERY_CREATOR_REFRESH_TOKEN=
